# Copiar a .env para desarrollo local. JWT_SECRET_KEY debe ser el mismo que usa aye-auth.
APP_NAME=AyeKitchen
APP_ENV=development
PORT=8000
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ayekitchen_dev
MONGODB_CERT_B64=
MONGODB_CERT_PATH=
JWT_SECRET_KEY=super_secure_secret_key_minimum_32_characters_for_ayeapps_atelier
JWT_ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3006"]
